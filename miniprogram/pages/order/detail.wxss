.status-bar {
  background: #2b7a5e;
  color: #fff;
  padding: 40rpx 30rpx;
}

.status-text {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.status-bar .muted {
  color: rgba(255, 255, 255, 0.8);
}

.block-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.addr {
  margin-top: 10rpx;
}

.item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f7f8fa;
}

.item-img {
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  background: #eef1f4;
  flex-shrink: 0;
}

.item-body {
  flex: 1;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.amount-line {
  padding: 12rpx 0;
}

.footer-space {
  height: 140rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 2rpx solid #f0f2f5;
}

.act {
  width: 220rpx;
  margin-left: 20rpx;
}
