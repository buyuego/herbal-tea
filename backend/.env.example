# 环境变量样例（对齐部署清单 V2 第 8 章；生产 .env 权限 600 不入代码库）
# 复制为 .env 后按实际申请结果填写

# ===== 数据库（模式 A 用云数据库基础版；模式 B 用本地容器） =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=herbal_tea
DB_USER=herbal_tea
DB_PASSWORD=change-me
DB_POOL_SIZE=50

# ===== Redis（仅缓存/验证码/限流语义） =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ===== JWT =====
JWT_SECRET=please-generate-64-random-chars-and-keep-secret

# ===== 微信小程序（企业主体认证后申请） =====
WX_MINIAPP_APPID=
WX_MINIAPP_SECRET=

# ===== 微信支付 + 服务商分账（1-3 周申请周期，最长链路，尽早启动） =====
WXPAY_MCH_ID=
WXPAY_API_V3_KEY=
WXPAY_PRIVATE_KEY_PATH=/opt/herbal-tea/certs/apiclient_key.pem
WXPAY_NOTIFY_URL=https://your-domain.com/api/wxpay/notify

# ===== 短信（异地登录强制验证，签名/模板审核 3-5 天） =====
SMS_PROVIDER_KEY=
SMS_SIGN_NAME=

# ===== 对象存储（商品图 COS 直传） =====
OSS_BUCKET=
OSS_SECRET_ID=
OSS_SECRET_KEY=

# ===== 物流（轨迹查询，AFT-005） =====
LOGISTICS_APP_KEY=
LOGISTICS_SECRET=

# ===== Outbox =====
OUTBOX_SCAN_INTERVAL=5000
OUTBOX_BATCH=100
OUTBOX_BACKLOG_ALERT=100

# ===== 域名 / TLS =====
DOMAIN=
TLS_CERT_PATH=
TLS_KEY_PATH=
