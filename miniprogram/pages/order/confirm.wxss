.addr-name {
  font-size: 30rpx;
  font-weight: 600;
}

.addr-detail {
  margin-top: 10rpx;
}

.block-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f7f8fa;
}

.item-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #eef1f4;
  flex-shrink: 0;
}

.item-body {
  flex: 1;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.coupon-opt {
  border: 2rpx solid #e4e7ed;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.coupon-opt-active {
  border-color: #2b7a5e;
  background: #f2f8f5;
}

.points-row {
  margin-top: 20rpx;
}

.points-input {
  flex: 1;
  border: 2rpx solid #e4e7ed;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  margin-right: 20rpx;
}

.remark {
  text-align: right;
  flex: 1;
}

.amount-line {
  padding: 12rpx 0;
}

.footer-space {
  height: 140rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 2rpx solid #f0f2f5;
}

.pay-btn {
  width: 260rpx;
}
