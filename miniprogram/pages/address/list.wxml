<view class="container">
  <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onTap">
    <view class="between">
      <view>
        <text class="name">{{item.receiverName}}</text>
        <text class="muted phone">{{item.phone}}</text>
      </view>
      <text class="tag" wx:if="{{item.isDefault === 1}}">默认</text>
    </view>
    <view class="muted addr">{{item.province}}{{item.city}}{{item.district}}{{item.detail}}</view>
    <view class="ops">
      <text class="op" data-id="{{item.id}}" catchtap="remove">删除</text>
    </view>
  </view>
</view>

<view class="empty" wx:if="{{!loading && !list.length}}">还没有收货地址</view>

<view class="footer-space"></view>
<view class="footer">
  <view class="btn-primary add-btn" bindtap="add">新增收货地址</view>
</view>
