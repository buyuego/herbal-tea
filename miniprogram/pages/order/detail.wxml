<view class="loading" wx:if="{{loading}}">加载中...</view>

<block wx:elif="{{order}}">
  <view class="status-bar">
    <view class="status-text">{{order.statusDesc}}</view>
    <view class="muted" wx:if="{{order.status === 10}}">请在 {{order.expireText}} 前完成支付</view>
    <view class="muted" wx:elif="{{order.trackingNo}}">{{order.carrier}} {{order.trackingNo}}</view>
  </view>

  <view class="container">
    <view class="card">
      <view class="block-title">收货信息</view>
      <view class="between">
        <text>{{order.receiverName}}</text>
        <text class="muted">{{order.receiverPhone}}</text>
      </view>
      <view class="muted addr">{{order.receiverAddress}}</view>
    </view>

    <view class="card">
      <view class="block-title">商品</view>
      <view class="item" wx:for="{{items}}" wx:key="name">
        <image class="item-img" src="{{item.image}}" mode="aspectFill" />
        <view class="item-body">
          <view class="item-name">{{item.name}}</view>
          <view class="muted">{{item.specsText}}</view>
          <view class="between">
            <text class="price">¥{{item.priceText}}</text>
            <text class="muted">x{{item.qty}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="block-title">金额</view>
      <view class="between amount-line">
        <text class="muted">商品金额</text>
        <text>¥{{order.totalAmountText}}</text>
      </view>
      <view class="between amount-line" wx:if="{{order.hasPromotion}}">
        <text class="muted">活动优惠</text>
        <text>-¥{{order.promotionDiscountText}}</text>
      </view>
      <view class="between amount-line">
        <text class="muted">优惠券</text>
        <text>-¥{{order.couponAmountText}}</text>
      </view>
      <view class="between amount-line">
        <text class="muted">积分抵扣</text>
        <text>-¥{{order.pointsDeductAmountText}}</text>
      </view>
      <view class="between amount-line">
        <text>实付</text>
        <text class="price">¥{{order.payAmountText}}</text>
      </view>
    </view>

    <view class="card">
      <view class="block-title">订单信息</view>
      <view class="between amount-line">
        <text class="muted">订单号</text>
        <text>{{order.orderNo}}</text>
      </view>
      <view class="between amount-line">
        <text class="muted">下单时间</text>
        <text>{{order.createdText}}</text>
      </view>
      <view class="between amount-line" wx:if="{{order.paidText}}">
        <text class="muted">支付时间</text>
        <text>{{order.paidText}}</text>
      </view>
      <view class="between amount-line" wx:if="{{order.shippedText}}">
        <text class="muted">发货时间</text>
        <text>{{order.shippedText}}</text>
      </view>
      <view class="between amount-line" wx:if="{{order.remark}}">
        <text class="muted">备注</text>
        <text>{{order.remark}}</text>
      </view>
    </view>
  </view>

  <view class="footer-space" wx:if="{{canPay || canSign}}"></view>
  <view class="footer" wx:if="{{canPay || canSign}}">
    <block wx:if="{{canPay}}">
      <view class="btn-ghost act" bindtap="cancel">取消订单</view>
      <view class="btn-primary act" bindtap="pay">立即支付</view>
    </block>
    <block wx:elif="{{canSign}}">
      <view class="btn-primary act" bindtap="sign">确认收货</view>
    </block>
  </view>
</block>
