.store-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #2b7a5e;
  color: #fff;
  padding: 24rpx 30rpx;
}

/* 门店生效活动横幅（v30） */
.promo-bar {
  background: #fff8e6;
  padding: 16rpx 30rpx;
}

.promo-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.promo-tag {
  flex: none;
  font-size: 20rpx;
  color: #b8860b;
  border: 1rpx solid #e6c34a;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

.promo-title {
  font-size: 26rpx;
  color: #8a6d1a;
  font-weight: 600;
}

.promo-rule {
  font-size: 24rpx;
  color: #b8860b;
}

.store-left {
  display: flex;
  flex-direction: column;
}

.store-label {
  font-size: 22rpx;
  opacity: 0.75;
}

.store-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.store-switch {
  font-size: 26rpx;
  opacity: 0.9;
}

.cate-bar {
  white-space: nowrap;
  background: #fff;
  padding: 20rpx 10rpx;
  border-bottom: 2rpx solid #f0f2f5;
}

.cate {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin: 0 8rpx;
  font-size: 26rpx;
  color: #606266;
  border-radius: 30rpx;
  background: #f5f7fa;
}

.cate-active {
  background: #2b7a5e;
  color: #fff;
}

.goods {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx;
}

.goods-item {
  width: 48%;
  margin: 1%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  padding-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.goods-img {
  width: 100%;
  height: 320rpx;
  background: #eef1f4;
}

.goods-name {
  font-size: 28rpx;
  padding: 14rpx 16rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-sub {
  font-size: 22rpx;
  color: #909399;
  padding: 6rpx 16rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 16rpx 0;
}

.sold-out {
  font-size: 22rpx;
  color: #c0c4cc;
}
