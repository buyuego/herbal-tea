.tabs {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid #f0f2f5;
  position: sticky;
  top: 0;
  z-index: 5;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #606266;
}

.tab-active {
  color: #2b7a5e;
  font-weight: 600;
  border-bottom: 4rpx solid #2b7a5e;
}

.status {
  color: #e6a23c;
  font-size: 26rpx;
}

.amount-row {
  margin: 16rpx 0 10rpx;
}

.actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f7fa;
}

.act {
  width: 180rpx;
  margin-left: 20rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
}
