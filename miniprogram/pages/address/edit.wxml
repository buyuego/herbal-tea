<view class="container">
  <view class="card">
    <view class="field">
      <text class="label">收货人</text>
      <input class="input" value="{{form.receiverName}}" data-key="receiverName" bindinput="onInput" placeholder="请填写收货人姓名" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" value="{{form.phone}}" data-key="phone" bindinput="onInput" placeholder="请填写手机号" />
    </view>
    <view class="field">
      <text class="label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegion">
        <view class="input picker">
          {{form.province ? form.province + form.city + form.district : '请选择省市区'}}
        </view>
      </picker>
    </view>
    <view class="field">
      <text class="label">详细地址</text>
      <input class="input" value="{{form.detail}}" data-key="detail" bindinput="onInput" placeholder="街道、门牌号等" />
    </view>
    <view class="field between">
      <text class="label">设为默认</text>
      <switch checked="{{form.isDefault === 1}}" color="#2b7a5e" bindchange="onDefault" />
    </view>
  </view>

  <view class="btn-primary save-btn" bindtap="save">保存</view>
</view>
